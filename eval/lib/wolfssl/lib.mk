# DESC: wolfSSL 5.9.4, axis FEWER; tables are in flash in EVERY build
# wolfSSL. Pinned at 5.9.4-stable; wolfssl/version.h ships in the repository
# so nothing has to be generated by autotools before building.
#
# ONE AXIS, WOLFSSL'S OWN OPTION, DEFAULTING OFF:
#
#   FEWER=0|1    WOLFSSL_AES_SMALL_TABLES.
#       Off: Te[4][256] and Td[4][256], `static const` and so IN FLASH IN
#       EVERY BUILD - wolfSSL has no ROM/RAM switch, which is the
#       interesting difference from Mbed-TLS: its stock configuration
#       already has the tables in flash, so there is no quiet default to
#       compare against and the link-time twin is the only residence axis.
#       On: a 256-byte Tsbox.
#
# Reached through WOLFSSL_USER_SETTINGS - wolfSSL's own documented
# mechanism. No library source is modified.

WOLFSSL_DIR = $(ROOT)/libs/wolfssl

FEWER ?= 0

LIB_SRC  += $(WOLFSSL_DIR)/wolfcrypt/src/aes.c
LIB_INC  += -I$(WOLFSSL_DIR) -I$(LIBDIR)
LIB_DEFS += -DLIB_WOLFSSL -DWOLFSSL_USER_SETTINGS

ifeq ($(FEWER),1)
  LIB_DEFS += -DSS_WOLFSSL_SMALL_TABLES
endif

LIB_VARIANT = -few$(FEWER)
LIB_HAS_VENDOR = 1
